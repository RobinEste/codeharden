#!/usr/bin/env bash
# Blocks a push of a branch whose tests haven't passed on this machine (see "Local test gate"
# in AGENTS.md). Enabled per clone with: git config core.hooksPath scripts/harden/hooks
#
# Not gated: tags, deletions, and pushes to harden or main (they receive merges and release
# commits, which were tested on their branches), and branches that change documentation only.
# Git's own `--no-verify` skips the hook; say so in the pull request if you ever use it.
set -euo pipefail

zero="0000000000000000000000000000000000000000"
docs='^docs/|^LICENSE$|^[^/]+\.md$|^(apps|packages)/[^/]+/README\.md$|^apps/runner/src/browser/README\.md$|^[^/]+\.(png|jpe?g|gif|svg|webp)$'
head=$(git rev-parse HEAD)

while read -r local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in
    refs/tags/* | refs/heads/harden | refs/heads/main) continue ;;
  esac
  # Documentation only, compared with harden: nothing to test (CI skips these too).
  base=$(git merge-base "$local_sha" refs/remotes/origin/harden 2> /dev/null || true)
  if [ -n "$base" ]; then
    changed=$(git diff --name-only "$base" "$local_sha")
    if [ -z "$changed" ] || ! grep -qvE "$docs" <<< "$changed"; then continue; fi
  fi
  if [ "$local_sha" != "$head" ]; then
    echo "pre-push: ${local_ref} is not the checked-out commit, so its tests can't run here. Check it out and push from there." >&2
    exit 1
  fi
  # The hook's stdin is the list of refs; the tests must not read it.
  "$(git rev-parse --show-toplevel)/scripts/harden/local-checks.sh" < /dev/null >&2 || exit 1
done
exit 0
